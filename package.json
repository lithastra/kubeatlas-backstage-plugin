{
  "name": "@lithastra/plugin-kubeatlas",
  "version": "0.1.0",
  "description": "Backstage frontend plugin embedding KubeAtlas dependency-graph views into Entity pages",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "homepage": "https://github.com/lithastra/kubeatlas-backstage-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/lithastra/kubeatlas-backstage-plugin.git"
  },
  "backstage": {
    "role": "frontend-plugin"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "kubernetes",
    "dependency-graph",
    "kubeatlas"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test --coverage",
    "test:e2e": "playwright test",
    "tsc": "tsc",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.7.0",
    "@backstage/core-components": "^0.16.0",
    "@backstage/core-plugin-api": "^1.10.0",
    "@backstage/plugin-catalog-react": "^1.15.0",
    "@backstage/theme": "^0.6.0",
    "@material-ui/core": "^4.12.2",
    "cytoscape": "^3.30.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.29.0",
    "@backstage/dev-utils": "^1.1.0",
    "@backstage/test-utils": "^1.7.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^15.0.0",
    "@types/cytoscape": "^3.21.0",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "typescript": "~5.4.0"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "kubeatlas": {
        "type": "object",
        "properties": {
          "baseUrl": {
            "type": "string",
            "description": "Base URL of the KubeAtlas server's v1 API, e.g. https://kubeatlas.example.com",
            "visibility": "frontend"
          }
        }
      }
    }
  }
}
